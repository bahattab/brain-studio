{
  "name": "brain-studio",
  "version": "2.2.6",
  "private": true,
  "description": "Offline multilingual assessment, career exploration and development workspace with research-attributed scoring",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "smoke": "electron . --smoke-test",
    "package": "node scripts/build-locales.cjs && node scripts/package.cjs",
    "locales": "node scripts/build-locales.cjs",
    "test:platform": "node --test --test-concurrency=1 tests/platform/*.cjs",
    "build:web": "node scripts/build-locales.cjs && node scripts/platform/build-web.cjs",
    "build:win": "node scripts/build-locales.cjs && electron-builder --win --x64 --publish never",
    "build:mac": "node scripts/build-locales.cjs && electron-builder --mac --publish never",
    "build:linux": "node scripts/build-locales.cjs && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "license": "MIT",
  "author": "Brain Studio contributors"
}
